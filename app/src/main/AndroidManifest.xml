<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShixuJi">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 长按图标弹出的快捷方式（res/xml/shortcuts.xml）。
                 launchMode=singleTop 是为了「App 已经在后台」时点快捷方式不再起第二个实例：
                 走 onNewIntent 复用现有界面，否则叠两层 MainActivity、返回键要按两下才退。 -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- 分享备份文件用：只暴露 cacheDir/backup_share/，不碰外部存储、不要任何权限。
             authority 用 ${applicationId} 占位符，将来加 flavor / applicationIdSuffix 不会错配
             （调用点也必须用 ctx.packageName + ".fileprovider"，别写死包名）。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>